# ── Vertex AI (recommended for production / GCP) ──────────────────────────
# Uses Application Default Credentials (ADC) — run `gcloud auth application-default login` locally
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── API Key fallback (for local dev without GCP) ──────────────────────────
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY="your_api_key_here"

# Optional: override default model
GEMINI_MODEL=gemini-2.0-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FastAPI backend (decisiontwin-api)
VITE_FASTAPI_URL=http://localhost:8000

# Express Gemini microservice (empty = same-origin /api in dev)
VITE_EXPRESS_API_URL=
